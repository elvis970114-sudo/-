#charge.multi-digit{letter-spacing:.12em}@media(max-width:780px){.intro-modal .modal{padding:22px}.intro-modal .tag{font-size:36px}.intro-modal .modal h2{font-size:76px}.intro-modal .modal p{font-size:48px}.intro-modal .level b{font-size:48px}.intro-modal .level small,.intro-modal .level em{font-size:40px}.intro-modal .primary,.intro-modal .secondary{font-size:50px;padding:24px}.intro-modal .tip{font-size:36px!important}}</style></head><body><div class="grain"></div><div id="dimmer" class="dim"></div><main class="wrap"><header class="nav"><div class="brand"><div class="logo">◒</div>MIDNIGHT / BATTERY</div><div class="navnote">A SMALL GAME ABOUT TIMING</div></header><div class="layout"><section class="intro"><div class="eyebrow">午夜任務　／　限時遊戲</div><h1>差一點點，<br><span>剛剛好。</span></h1><p>午夜前，把手機電量停在指定數字。真正調亮或調暗你的遊戲畫面，在設定裡找到更多操作；有些功能，就藏在手機邊框裡。</p><div class="rule"></div><div class="steps"><div class="step"><div class="num">01</div><div><strong>挑一段時間</strong><p>選兩分鐘、一分半、一分鐘或半分鐘挑戰。</p></div></div><div class="step"><div class="num">02</div><div><strong>探索手機</strong><p>設定、手電筒、相機和邊框都有玄機。</p></div></div><div class="step"><div class="num">03</div><div><strong>看電量變化</strong><p>效果不會標示，靠你自己試出規律。</p></div></div><div class="step"><div class="num">04</div><div><strong>午夜決勝</strong><p>達標立即勝利；倒數歸零仍未達標就失敗。</p></div></div></div></section><section class="device"><div class="screen" id="screen"><div class="island"></div><div class="status"><span id="statusClock">23:58</span><div class="status-right"><span id="wifi" class="wifi">◔ Wi-Fi</span><div class="mini-batt"><i id="miniFill"></i></div></div></div><div class="body"><div class="topline"><span id="phoneDate">星期日 · 10月 04日</span><span class="live"></span></div><div class="clock" id="clock">23:58</div><div class="subclock" id="countdown">離午夜還有 02:00</div><div class="charge-card"><div class="charge-label">目前電量</div><div class="charge-num"><span id="charge">63</span><span>%</span></div><div class="rail"><div class="fill" id="fill"></div></div><div class="charge-foot"><span>低耗電模式</span><span id="batteryMood">電量狀態良好</span></div></div><div class="mission"><div><small>午夜目標電量</small><strong><span id="goal">—</span><span style="font-size:11px;color:#abb5ad"> %</span></strong></div><div id="gap" class="gap">等待開始</div></div><div class="head"><b>你的手機</b><small>點擊探索　·　效果待發現</small></div><div class="apps"><button class="app" data-app="settings"><div class="icon">⚙</div>設定</button><button class="app" data-app="music"><div class="icon">♫</div>音樂</button><button class="app" data-app="maps"><div class="icon">⌖</div>地圖</button><button class="app" data-app="social"><div class="icon">▣</div>社群</button><button class="app" data-app="notes"><div class="icon">▤</div>備忘錄</button><button class="app" data-app="sleep"><div class="icon">◐</div>螢幕休眠</button></div><div class="activity"><span id="activity">尚未操作 · 找找邊框上藏了什麼</span><b id="actionCount">0 次</b></div></div><div class="home"><i></i></div><div id="overlay" class="overlay"><div class="modal" id="modal"></div></div><div id="wifiAlert" class="wifi-alert hide">◌　Wi-Fi 斷線中　·　5 秒後恢復</div><div id="off" class="off hide"><div>螢幕已關閉<small>點擊畫面任意處喚醒</small></div></div></div></section></div></main>
<script>
(()=>{'use strict';const $=x=>document.getElementById(x),screen=$('screen'),overlay=$('overlay'),modal=$('modal');screen.append(document.getElementById('dimmer'));document.getElementById('dimmer').style.position='absolute';const S={running:false,ended:false,level:'2m',seconds:120,left:120,battery:63,target:0,effects:{},wifi:true,outages:[],outageN:1,actions:0,won:false,flash:false,timer:null,log:[],toastTimer:null};const levels={ '2m':['兩分鐘','超簡單',120], '90s':['一分半','普通',90], '1m':['一分鐘','有點難',60], '30s':['半分鐘','非常困難',30]};const actions={music:['音樂','♫'],maps:['地圖','⌖'],social:['社群','▣'],notes:['備忘錄','▤'],camera:['相機','◉'],torch:['手電筒','✦'],rotate:['自動旋轉','⟳'],airplane:['飛航模式','✈'],refresh:['背景更新','↻'],saver:['省電模式','⌁'],volume:['音量','◖'],screen:['螢幕休眠','◐']};const R=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;function show(html){modal.innerHTML=html;overlay.classList.toggle('intro-modal',html.includes('MIDNIGHT / BATTERY')||html.includes('開始之前'));overlay.classList.remove('hide')}function close(){overlay.classList.add('hide')}function pick(){show(`<div class="tag">MIDNIGHT / BATTERY</div><h2>午夜前，把電量調到剛剛好。</h2><p>遊戲時間跟著真實時間走。先選擇倒數時間，開始前會有快速教學。</p>${Object.entries(levels).map(([id,v])=>`<button class="level ${S.level===id?'selected':''}" data-level="${id}"><span><b>${v[0]}</b><small>${v[1]}</small></span><em>${v[0]}</em></button>`).join('')}<button class="primary" id="continue">繼續　→</button><p class="tip">留意手機邊框的兩側音量鍵與電源鍵。</p>`);modal.querySelectorAll('[data-level]').forEach(b=>b.onclick=()=>{S.level=b.dataset.level;S.seconds=levels[S.level][2];pick()});$('continue').onclick=teach}function teach(){S.outageN=R(1,3);show(`<div class="tag">開始之前 · 快速教學</div><h2>怎麼玩</h2><p>目前電量與目標電量有些差距，點擊桌面上的各個程式使電量達標吧！</p><p>關閉螢幕會切換到獨立的全黑待機畫面，點一下就能回到遊戲。Wi-Fi 隨機斷線 ${S.outageN} 次，每次五秒；斷線時的操作不改變電量。</p><button class="primary" id="start">開始 ${levels[S.level][0]} 挑戰　→</button><button class="secondary" id="back">← 回去選時間</button>`);$('start').onclick=start;$('back').onclick=pick}function start(){S.running=true;S.ended=false;S.won=false;S.left=S.seconds;S.battery=R(35,72);S.actions=0;S.log=[];S.effects={};Object.keys(actions).forEach(k=>{let v=R(-9,9);S.effects[k]=Math.abs(v)===1?v*2:v||4});S.effects.screen=S.effects.screen||3;let reachable=new Set([S.battery]),n=S.battery;for(let i=0;i<100;i++){let k=Object.keys(actions)[R(0,Object.keys(actions).length-1)];n=Math.max(1,Math.min(99,n+S.effects[k]));reachable.add(n)}let choices=[...reachable].filter(x=>x!==S.battery);S.target=choices[R(0,choices.length-1)]||S.battery+1;S.outages=Array.from({length:S.outageN},()=>R(5,Math.max(6,S.seconds-7))).sort((a,b)=>a-b);document.documentElement.style.setProperty('--dimmer','0');$('off').classList.add('hide');$('wifiAlert').classList.add('hide');close();draw();S.timer=setInterval(tick,200)}function draw(){if(!S.running)return;$('charge').textContent=S.battery;$('charge').classList.toggle('multi-digit',String(S.battery).length>1);$('goal').textContent=S.target;$('fill').style.width=S.battery+'%';$('miniFill').style.width=S.battery+'%';$('actionCount').textContent=S.actions+' 次';$('gap').textContent=S.battery===S.target?'目標達成！':`任務進行中`;$('batteryMood').textContent=S.battery>60?'電量狀態良好':S.battery>30?'電量稍低':'即將耗盡';$('activity').textContent=S.log.at(-1)||'試試不同操作 · 邊框按鍵也能互動';let total=Math.ceil(S.left),m=Math.floor(total/60),s=total%60,clockSeconds=86400-total;let clock=`${String(Math.floor(clockSeconds/3600)%24).padStart(2,'0')}:${String(Math.floor(clockSeconds%3600/60)).padStart(2,'0')}`;$('clock').textContent=clock;$('statusClock').textContent=clock;$('countdown').textContent=`離午夜還有 ${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;if(S.left<=0){$('clock').textContent='00:00';$('statusClock').textContent='00:00'}}function tick(){if(!S.running||S.ended)return;S.left=Math.max(0,S.left-.2);const elapsed=S.seconds-S.left,sec=Math.floor(elapsed);S.wifi=!S.outages.some(t=>sec>=t&&sec<t+5);$('wifi').classList.toggle('down',!S.wifi);$('wifi').textContent=S.wifi?'◔ Wi-Fi':'× Wi-Fi';$('wifiAlert').classList.toggle('hide',S.wifi);draw();if(S.left<=0){finish(false);return}}function finish(win){if(S.ended)return;S.ended=true;S.won=win;clearInterval(S.timer);show(`<div class="result-modal"><div class="tag">${win?'目標達成 · MISSION CLEAR':'倒數歸零 · TIME UP'}</div><div class="result-hero ${win?'result-win':'result-lose'}">${win?'✦':'◌'}</div><h2 class="${win?'result-win':'result-lose'}">${win?'漂亮，剛剛好！':'午夜到了。挑戰失敗'}</h2><p>${win?'你在時間內把電量調到了目標。':'再試一次，這次多探索幾種操作。'}</p><div class="result-score">${S.battery}%</div><p>目標 ${S.target}%　·　操作 ${S.actions} 次<br>${levels[S.level][0]}挑戰</p><button class="primary" id="retry">再來一次　↻</button><button class="secondary" id="chooseAgain">重新選擇時間</button></div>`);$('retry').onclick=()=>start();$('chooseAgain').onclick=()=>{S.running=false;S.ended=false;S.level='2m';pick()}}function pulse(){if(!S.wifi){toast('Wi-Fi 目前中斷','操作無效，等連線恢復再試');return false}return true}function toast(title,msg){let old=$('toast');if(old)old.remove();let t=document.createElement('div');t.id='toast';t.className='toast';t.innerHTML=`${title}`;screen.append(t);clearTimeout(S.toastTimer);S.toastTimer=setTimeout(()=>t.remove(),1700)}function effect(id,label){if(!S.running||S.ended)return;if(!pulse())return;S.battery=Math.max(0,Math.min(100,S.battery+S.effects[id]));S.actions++;S.log.push(label+' · 電量有變化');draw();toast(label,'電量已更新');if(S.battery===S.target){finish(true)}}function quickAction(id){if(id==='screen'){sleep();return}if(id==='torch'){let on=document.body.classList.toggle('torch-on');document.body.style.setProperty('--torch',on?'#fff8c5':'transparent')}effect(id,actions[id][0])}function settings(){if(!S.running||S.ended)return;show(`<div class="settings-head"><button class="back" id="settingsBack">‹</button><div><div class="tag" style="margin:0">設定</div><span style="font-size:9px;color:#9ba5a0">系統與快速功能</span></div></div><div class="mission" style="margin:0 0 10px"><div><small>目前電量</small><strong>${S.battery}%</strong></div><div style="text-align:right"><small>午夜目標</small><strong>${S.target}%</strong></div></div><div class="setting-row"><label><span>自動鎖定</span><output>30 秒</output></label></div><div class="setting-grid">${['airplane','refresh','saver','volume','camera','torch','rotate'].map(k=>`<button class="setting-app" data-setting="${k}">${actions[k][1]}　${actions[k][0]}<span>點擊切換　·　${'未知'}</span></button>`).join('')}</div><p class="tip">功能效果不會標示方向或數值，親自操作來記住它。</p>`);$('settingsBack').onclick=()=>{close();toast('回到主畫面','設定已關閉')};modal.querySelectorAll('[data-setting]').forEach(b=>b.onclick=()=>{let k=b.dataset.setting;if(k==='camera'){camera();return}if(k==='torch')document.body.classList.toggle('torch-on');effect(k,actions[k][0]);if(!S.ended)settings()})}function camera(){if(!S.running||S.ended)return;show(`<div class="settings-head"><button class="back" id="cameraBack">‹</button><div><div class="tag" style="margin:0">相機</div></div></div><div style="height:255px;background:radial-gradient(circle at 50% 45%,#52605a,#242c2a 32%,#111718);border:1px solid #44504a;border-radius:14px;display:grid;place-items:center;color:#9ba79c;font-size:35px">◉</div><p style="text-align:center;margin-top:10px">點快門拍一張照片</p><button class="primary" id="shutter">●　拍照</button>`);$('cameraBack').onclick=settings;$('shutter').onclick=()=>{effect('camera','相機快門');if(!S.ended){modal.querySelector('p').textContent='已拍攝 · 照片已儲存';let f=document.createElement('div');f.className='flash';screen.append(f);setTimeout(()=>f.remove(),400)}}}function sleep(){if(!S.running||S.ended)return;if(pulse())effect('screen','關閉螢幕');if(S.ended)return;close();$('off').classList.remove('hide')}function quickPanel(){if(!S.running||S.ended)return;show(`<div class="tag">控制中心</div><h2>快速控制</h2><div class="bodyquick">${['torch','camera','airplane','rotate'].map(k=>`<button class="quick" data-quick="${k}">${actions[k][1]}　${actions[k][0]}<span>點擊使用</span></button>`).join('')}</div><button class="secondary" id="qcClose">完成</button>`);modal.querySelectorAll('[data-quick]').forEach(b=>b.onclick=()=>{let k=b.dataset.quick;if(k==='camera'){camera();return}if(k==='torch')document.body.classList.toggle('torch-on');effect(k,actions[k][0])});$('qcClose').onclick=close}function init(){S.seconds=levels[S.level][2];const today=new Date();document.getElementById('phoneDate').textContent=new Intl.DateTimeFormat('zh-TW',{weekday:'long',month:'2-digit',day:'2-digit'}).format(today);show(`<div class="tag">MIDNIGHT / BATTERY</div><h2>準備好挑戰午夜了嗎？</h2><p>把電量調到隨機目標。遊戲中可打開設定和控制中心；側邊的音量鍵也藏著操作。</p>${Object.entries(levels).map(([id,v])=>`<button class="level ${S.level===id?'selected':''}" data-level="${id}"><span><b>${v[0]}</b><small>${v[1]}</small></span><em>${v[0]}</em></button>`).join('')}<button class="primary" id="continue">查看教學　→</button>`);modal.querySelectorAll('[data-level]').forEach(b=>b.onclick=()=>{S.level=b.dataset.level;S.seconds=levels[S.level][2];init()});$('continue').onclick=teach}document.querySelectorAll('[data-app]').forEach(b=>b.onclick=()=>{let id=b.dataset.app;if(id==='settings'){settings();return}if(id==='sleep'){sleep();return}effect(id,actions[id]?.[0]||id)});
// Side buttons are subtle but behave like real phone hardware keys.
const edgeL=document.createElement('button');edgeL.setAttribute('aria-label','音量減');edgeL.title='音量減';edgeL.style.cssText='position:absolute;z-index:4;left:-5px;top:164px;width:7px;height:39px;border:0;border-radius:5px 0 0 5px;background:#71807d;cursor:pointer';edgeL.onclick=()=>effect('volume','音量減');document.querySelector('.device').append(edgeL);const edgeR=document.createElement('button');edgeR.setAttribute('aria-label','電源鍵');edgeR.title='電源鍵';edgeR.style.cssText='position:absolute;z-index:4;right:-5px;top:260px;width:7px;height:45px;border:0;border-radius:0 5px 5px 0;background:#71807d;cursor:pointer';edgeR.onclick=sleep;document.querySelector('.device').append(edgeR);document.querySelector('.island').onclick=quickPanel;$('off').onclick=()=>{$('off').classList.add('hide');toast('螢幕已喚醒','回到手機主畫面')};init()})();
</script></body></html>
